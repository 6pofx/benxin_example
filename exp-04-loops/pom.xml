<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.benxin.exp</groupId>
        <artifactId>benxin-exp</artifactId>
        <version>1.0.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>exp-04-loops</artifactId>
    <name>exp-04-loops</name>
    <description>
        示例 04 · Agent Loop：8 个内置 Loop（dsh-minimal / react / claude-code / codex /
        plan-execute / reflexion / staged / workflow）逐个跑通并打印 AgentResult 全字段、
        @LlmLoop 自定义 Loop（含 SubAgentObserver 与 defaultLoop）、子代理的三种装配方式、
        LoopRegistry 全 API、步数预算与 hard-max-steps 夹取、AgentAttributes 运行属性。
        workflow 只在本模块点名（由 exp-05 专门演示），其余 7 个都真跑。
    </description>

    <dependencies>
        <dependency>
            <groupId>com.benxin</groupId>
            <artifactId>benxin-spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.benxin.exp</groupId>
            <artifactId>exp-common</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
