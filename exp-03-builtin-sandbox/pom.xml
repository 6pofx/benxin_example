<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.benxin.exp</groupId>
        <artifactId>benxin-exp</artifactId>
        <version>1.0.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>exp-03-builtin-sandbox</artifactId>
    <name>exp-03-builtin-sandbox</name>
    <description>
        示例 03 · 内置工具 + 沙箱 + 审批：8 个内置工具（read/write/edit/glob/grep/bash/
        todo_write/task）的真实调用、三重开关（builtin-enabled / allow-write / allow-exec）的
        真实语义、PathSandbox 的路径围栏、CommandSandbox 的三道闸、ApprovalPolicy 四态、
        ApprovalHandler 的三种实现、自定义 ToolSandbox 与 CompositeSandbox、纵深防御。
    </description>

    <dependencies>
        <dependency>
            <groupId>com.benxin</groupId>
            <artifactId>benxin-spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.benxin.exp</groupId>
            <artifactId>exp-common</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
